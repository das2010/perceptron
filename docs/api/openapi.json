      },
      "ProjectStatus": {
        "enum": [
          "draft",
          "active",
          "archived"
        ],
        "title": "ProjectStatus",
        "type": "string"
      },
      "RuntimeMode": {
        "description": "Dónde corre este Engine (SPEC §4.3).",
        "enum": [
          "desktop",
          "server"
        ],
        "title": "RuntimeMode",
        "type": "string"
      },
      "TaskType": {
        "enum": [
          "classification",
          "regression",
