{
  "components": {
    "schemas": {
      "CPUInfo": {
        "properties": {
          "arch": {
            "title": "Arch",
            "type": "string"
          },
          "flags": {
            "description": "Instrucciones relevantes (avx2, avx512…)",
            "items": {
              "type": "string"
            },
            "title": "Flags",
            "type": "array"
          },
          "logical_cores": {
            "title": "Logical Cores",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "physical_cores": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Physical Cores"
          }
        },
        "required": [
          "model",
          "physical_cores",
          "logical_cores",
          "arch"
        ],
        "title": "CPUInfo",
        "type": "object"
      },
      "Device": {
        "enum": [
          "cuda",
          "rocm",
          "xpu",
          "cpu"
        ],
        "title": "Device",
        "type": "string"
      },
      "GPUInfo": {
        "properties": {
          "backend": {
            "$ref": "#/components/schemas/Device"
          },
          "compute_capability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compute Capability"
          },
          "driver": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Driver"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "supports_bf16": {
            "default": false,
            "title": "Supports Bf16",
            "type": "boolean"
          },
          "vram_free_gb": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vram Free Gb"
          },
          "vram_total_gb": {
            "title": "Vram Total Gb",
            "type": "number"
          }
        },
        "required": [
          "index",
          "backend",
          "name",
          "vram_total_gb"
        ],
        "title": "GPUInfo",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HardwareReport": {
        "properties": {
          "cpu": {
            "$ref": "#/components/schemas/CPUInfo"
          },
          "disk_free_gb": {
            "title": "Disk Free Gb",
            "type": "number"
          },
          "gpus": {
            "items": {
              "$ref": "#/components/schemas/GPUInfo"
            },
            "title": "Gpus",
            "type": "array"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "os": {
            "title": "Os",
            "type": "string"
          },
          "python": {
            "title": "Python",
            "type": "string"
          },
          "ram_available_gb": {
            "title": "Ram Available Gb",
            "type": "number"
          },
          "ram_total_gb": {
            "title": "Ram Total Gb",
            "type": "number"
          },
          "recommended_device": {
            "$ref": "#/components/schemas/Device"
          },
          "recommended_torch_variant": {
            "title": "Recommended Torch Variant",
            "type": "string"
          },
          "torch": {
            "$ref": "#/components/schemas/TorchInfo"
          }
        },
        "required": [
          "os",
          "python",
          "cpu",
          "ram_total_gb",
          "ram_available_gb",
          "disk_free_gb",
          "torch",
          "recommended_device",
          "recommended_torch_variant"
        ],
        "title": "HardwareReport",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "Modality": {
        "enum": [
          "tabular",
          "image",
          "text",
          "timeseries",
          "audio"
        ],
        "title": "Modality",
        "type": "string"
      },
      "PrivacyLevel": {
        "description": "Qué puede recibir el LLM (SPEC §7.7.3).",
        "enum": [
          "L0",
          "L1",
          "L2",
          "L3"
        ],
        "title": "PrivacyLevel",
        "type": "string"
      },
      "Project": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "goal": {
            "default": "",
            "description": "Objetivo en lenguaje natural del usuario",
            "title": "Goal",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "llm_profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Profile Id"
          },
          "modalities": {
            "items": {
              "$ref": "#/components/schemas/Modality"
            },
            "title": "Modalities",
            "type": "array"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "privacy_level": {
            "$ref": "#/components/schemas/PrivacyLevel",
            "default": "L1"
          },
          "scope": {
            "$ref": "#/components/schemas/ProjectScope",
            "default": "local"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus",
            "default": "draft"
          },
          "target_metric": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Metric"
          },
          "task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskType"
              },
              {
                "type": "null"
              }
            ]
          },
          "template": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Plantilla UC-xx de origen",
            "title": "Template"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "default": 1,
            "description": "Versión para bloqueo optimista",
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          },
          "workspace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workspace Id"
          }
        },
        "required": [
          "name"
        ],
        "title": "Project",
        "type": "object"
      },
      "ProjectCreate": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "goal": {
            "default": "",
            "title": "Goal",
            "type": "string"
          },
          "modalities": {
            "items": {
              "$ref": "#/components/schemas/Modality"
            },
            "title": "Modalities",
            "type": "array"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "privacy_level": {
            "$ref": "#/components/schemas/PrivacyLevel",
            "default": "L1"
          },
          "target_metric": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Metric"
          },
          "task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskType"
              },
              {
                "type": "null"
              }
            ]
          },
          "template": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Template"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectCreate",
        "type": "object"
      },
      "ProjectPatch": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "modalities": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Modality"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modalities"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "privacy_level": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PrivacyLevel"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProjectStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_metric": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Metric"
          },
          "task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskType"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "description": "Versión conocida por el cliente (bloqueo optimista)",
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
