# Servidor de inferencia CPU de «{{ name }}» (generado por Perceptron {{ version }}).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/srv/vendor PERCEPTRON_MODEL_DIR=/srv/app/model
WORKDIR /srv
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv
COPY requirements.txt .
RUN uv pip install --system --no-cache -r requirements.txt{% if needs_torch %} \
    && uv pip install --system --no-cache --index-url https://download.pytorch.org/whl/cpu \
       torch=={{ torch_version }} torchvision=={{ torchvision_version }}{% endif %}
COPY vendor/ vendor/
COPY app/ app/
EXPOSE 8000
CMD ["uvicorn", "app.app:app", "--host", "0.0.0.0", "--port", "8000"]
