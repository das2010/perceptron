# Copiar a server/deploy/.env y completar. Nunca commitear el .env.
POSTGRES_PASSWORD=
# openssl rand -hex 32
PERCEPTRON_SECRET_KEY=
# openssl rand -base64 32  (cifra las claves de proveedores LLM y fuentes)
PERCEPTRON_MASTER_KEY=
# Primer Admin: solo se usa si todavía no hay usuarios. Después se puede borrar.
PERCEPTRON_ADMIN_EMAIL=admin@empresa.com
PERCEPTRON_ADMIN_PASSWORD=
# Detrás de un proxy con TLS: true. Solo en pruebas locales sin HTTPS: false.
PERCEPTRON_COOKIE_SECURE=true
PERCEPTRON_PORT=8080
# Carpeta del host montada (solo lectura) como «fuente del servidor».
PERCEPTRON_SOURCES_DIR=./sources
# IPs del proxy inverso confiable (X-Forwarded-For / X-Forwarded-Proto).
PERCEPTRON_TRUSTED_PROXIES=127.0.0.1
# Red (protección SSRF): el servidor no conecta a direcciones internas (LAN, loopback, metadata)
# desde fuentes API/WebSocket, webhooks o bases de datos. Para habilitar hosts puntuales:
# PERCEPTRON_NETWORK__ALLOWED_HOSTS='["db.intranet.empresa.com","10.0.0.5"]'
# Swagger de la API (apagado por defecto en el servidor):
# PERCEPTRON_API__DOCS=true
