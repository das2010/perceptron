{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perceptron",
  "version": "0.1.0",
  "identifier": "com.preteco.perceptron",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @perceptron/ui dev",
    "beforeBuildCommand": "pnpm --filter @perceptron/ui build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "publisher": "Preteco",
    "category": "DeveloperTool",
    "shortDescription": "Diseñá, entrená y evaluá redes neuronales sin código",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
